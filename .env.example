# ============================================================
# AI Radio â€” Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# .env is gitignored and should never be committed.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Catalog media location (defaults to server/catalog) ---
CATALOG_DIR=D:/catalog
# Radio Mode talk-break music beds (manifest.json + MP3/Opus); defaults to CATALOG_DIR/music_beds
# MUSIC_BEDS_DIR=D:/catalog/music_beds

# --- Backend bind address (nginx proxies to 127.0.0.1:8000) ---
HOST=127.0.0.1
PORT=8000

# --- Logging ---
# The console and data/logs/radio.log show one line per listener event. Per-segment / per-lookup detail
# (TTS cache lookups, audio processing, planner segments, queue fills) is hidden unless its category is
# listed here, e.g. LOG_VERBOSE=tts_vector_db,tts_generation or LOG_VERBOSE=all
LOG_VERBOSE=

# --- Public security settings ---
PUBLIC_BASE_URL=https://plair.live
CORS_ORIGINS=https://plair.live,https://www.plair.live
TRUSTED_PROXY_IPS=127.0.0.1,::1
ADMIN_USER_IDS=1
ENABLE_API_DOCS=false
PROMPT_DEBUG_ENABLED=false
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# --- GPU placement (PCI order: 0 = Quadro P6000, 1 = Quadro RTX 6000) ---
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=0
WHISPER_COMPUTE_TYPE=int8

# --- Local TTS engine (tts_chatterbox/, Chatterbox-Turbo) ---
TTS_SERVER_URL=http://127.0.0.1:8090
TTS_SERVER_PORT=8090
TTS_SERVER_EXTERNAL=false
TTS_CUDA_VISIBLE_DEVICES=0
TTS_ENGINE_SLOTS=8
# Station computer voice for stings, IDs and the talking clock (changing it re-renders station_audio/<voice>/)


# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
STRIPE_ADDITIONAL_PRICE_IDS=
STRIPE_PRICE_LABEL=US$4.99/mo
PREMIUM_MONTHLY_GENERATIONS=50
FREE_GENERATION_LIMIT=5
FREE_GENERATION_PERIOD=month

# --- YouTube / Google OAuth ---
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-...
YOUTUBE_API_KEY=AIzaSy...

# --- Google Maps Platform (Places API New, Geocoding, Air Quality, Pollen share this key) ---
GOOGLE_PLACES_API_KEY=AIzaSy...

# --- Gemini ---
GEMINI_API_KEY=AIzaSy...
DJ_TOOL_MAX_LIVE_FETCHES=2
DJ_TOOL_THINKING_BUDGET=-1
DJ_TURN_TRACE_ENABLED=true
DJ_TURN_TRACE_HOURS=48
# City Pulse knowledge layer (services_radio/pulse.py)
PULSE_ENABLED=true
PULSE_NODE_TIMEOUT_S=2.5
PULSE_FETCH_TIMEOUT_S=7
PULSE_FETCH_BELOW=2
PULSE_SEMANTIC_ONLY_MIN=0.9
PULSE_PLACE_RADIUS_M=2000
PULSE_OFFERED_MEMORY_S=7200
PULSE_AIRED_PENALTY=0.35
PULSE_DEMAND_ENABLED=true
PULSE_TREND_MIN_ASKERS=3
PULSE_CHART_MIN_LISTENERS=2
PULSE_CHART_CACHE_S=900
PULSE_CONTEXT_ITEMS=4
DJ_AIRED_MEMORY_ENABLED=false
DJ_TRIVIA_PREFETCH_ENABLED=false
DJ_LISTENER_NOTES_ENABLED=true
DJ_WEATHER_CUES_ENABLED=true
DJ_SKY_CUES_ENABLED=true
DJ_LISTENER_STATS_ENABLED=true
DJ_STATION_STATS_ENABLED=true
DJ_GUEST_TIMEZONE_ENABLED=true
# Guests share their device location (after their first play or DJ interaction). Kept in memory per guest
# session only, never written to the database; expires after GUEST_LOCATION_TTL_S without an update
GUEST_LOCATION_ENABLED=true
GUEST_LOCATION_TTL_S=21600
GUEST_LOCATION_MAX_SESSIONS=5000
GUEST_LOCATION_MIN_INTERVAL_S=20
GUEST_LOCATION_MAX_UPDATES_PER_HOUR=30
GUEST_LOCATION_MAX_SPEED_KMH=1000
GUEST_LOCATION_JUMP_CONFIRM_KM=10
GUEST_LOCATION_MAX_ACCURACY_M=100000

# --- Suno ---
SUNO_API_KEY=...


# --- Weather ---
WEATHER_API_KEY=...

# --- Ticketmaster ---
TICKETMASTER_API_KEY=...

# --- JWT ---
JWT_SECRET_KEY=generate_with_python_-c_import_secrets_print_secrets.token_hex_32

# --- DeepSeek (background LLM work) ---
DEEPSEEK_API_KEY=sk-your-deepseek-key

# --- LLM routing: comma-separated provider:model fallback chains ---
LLM_LIVE=gemini:gemini-3.5-flash-lite,gemini:gemini-3.5-flash
LLM_DJ=gemini:gemini-2.5-flash,gemini:gemini-3.5-flash-lite
LLM_BACKGROUND=deepseek:deepseek-flash,gemini:gemini-3.5-flash-lite
LLM_ANNOUNCE=deepseek:deepseek-flash,gemini:gemini-3.5-flash-lite
LLM_INTERPRET=deepseek:deepseek-flash,gemini:gemini-3.5-flash-lite
LLM_USAGE_LOG_INTERVAL_S=600

# --- Shoutouts: play counting and re-enhancement of old recordings ---
SHOUTOUT_PLAY_DEDUPE_HOURS=6
RATE_LIMIT_SHOUTOUT_PLAY_GUEST_PER_MINUTE=30
ASSET_DOCTOR_SHOUTOUT_REENHANCE_ENABLED=true
ASSET_DOCTOR_SHOUTOUT_REENHANCE_PER_HOUR=6

# --- AI usage & cost tracking (admin "AI usage" view in the User panel) ---
# LLM prices live in server/services/llm_telemetry.py (PRICING). DeepSeek bills half price off-peak
# (peak = 01:00-04:00 and 06:00-10:00 UTC, Mon-Fri); set false to always price at peak rates.
LLM_DEEPSEEK_OFFPEAK_PRICING=true
USAGE_TRACKING_ENABLED=true
USAGE_RAW_RETENTION_DAYS=90
# "admin" = only ADMIN_USER_IDS see usage stats; "all" = every signed-in user can see their own (/api/usage/me)
USAGE_STATS_VISIBILITY=admin
RATE_LIMIT_USAGE_STATS_PER_MINUTE=30
# Local GPU work (Orpheus TTS, Whisper) has no API bill; put your electricity cost per GPU-hour here
# (e.g. P6000 ~250 W at $0.30/kWh = 0.075). 0 = not counted.
ELECTRICITY_COST_PER_GPU_HOUR_USD=0
# Suno (sunoapi.org): one generate call = 2 songs. Assumed ~12 credits per call at ~$0.005/credit (entry plans).
# Check your plan; the admin view also shows the credit drop it observed per generation.
SUNO_COST_PER_GENERATION_USD=0.06
SUNO_CREDITS_PER_GENERATION=12
# Per-call costs of external APIs (0 = free tier). Google Places Text Search with opening hours is the
# Pro SKU: $32 per 1,000 after the monthly free allowance - set 0 if you stay inside the free cap.
API_COST_WEATHER_CALL_USD=0
API_COST_NEWS_CALL_USD=0
API_COST_EVENTS_CALL_USD=0
API_COST_PLACES_CALL_USD=0.032
API_COST_PLACES_DETAILS_CALL_USD=0.017
API_COST_PLACES_IDS_CALL_USD=0
API_COST_BIOGRAPHY_CALL_USD=0
# Google Maps Platform list prices after the monthly free allowance (developers.google.com/maps/billing-and-pricing/pricing,
# checked Sep 2026): Geocoding $5 / 1,000 (10k free), Air Quality usage $5 / 1,000 (10k free),
# Pollen usage $10 / 1,000 (5k free). Set 0 if you stay inside the free caps (see AREA_*_DAILY_CAP).
API_COST_GEOCODING_CALL_USD=0.005
API_COST_AIR_QUALITY_CALL_USD=0.005
API_COST_POLLEN_CALL_USD=0.01
# Numeric subscription price and Stripe fees, used for the margin estimate
SUBSCRIPTION_PRICE_USD=4.99
STRIPE_FEE_PERCENT=2.9
STRIPE_FEE_FIXED_USD=0.30

# Shared per-city knowledge pool (City Pulse): one fetch per city, shared by every listener there
REGIONAL_EVENTS_ENABLED=true
REGIONAL_EVENTS_REFRESH_S=28800
REGIONAL_EVENTS_DAYS_AHEAD=28
REGIONAL_EVENTS_PAGES=2
# Places stays inactive until Places API (New) is enabled on GOOGLE_PLACES_API_KEY
REGIONAL_PLACES_ENABLED=true
REGIONAL_PLACES_REFRESH_S=1209600
REGIONAL_PLACES_CATEGORIES=cafe,bar,record store,live music venue,bookstore
REGIONAL_PLACES_PER_CATEGORY=10
REGIONAL_PLACES_RADIUS_M=15000
REGIONAL_PLACE_ID_RETENTION_DAYS=180
REGIONAL_PLACE_LOOKUPS_PER_HOUR=20
REGIONAL_MAX_ITEMS_PER_KIND=400
REGIONAL_READ_CACHE_S=600
REGIONAL_CITY_MATCH_KM=60
REGIONAL_ACTIVE_GUEST_MAX_AGE_S=86400
# Street-level place memory: searches like "good cafes nearby" are stored with their location and reused
# for any listener nearby asking something similar, instead of calling Google again
PLACE_MEMORY_ENABLED=true
PLACE_MEMORY_TTL_DAYS=30
PLACE_MEMORY_MIN_HITS=3
PLACE_MEMORY_QUERY_MATCH=0.6
PLACE_MEMORY_REUSE_DISTANCE_M=400
# News store (Google News only, international): every pull (top stories, topic sections, the listener's city
# geo feed, free-text searches) is stored in Postgres with its items, LLM ranking and topic tags, and shared
# per country. A new ask reuses a stored pull of the same kind within its freshness window, or any fresh pull
# whose stored items cover the ask (topic tags, words, T5 similarity); otherwise it fetches and stores.
NEWS_STORE_ENABLED=true
NEWS_TOP_FRESH_S=2700
NEWS_GEO_FRESH_S=3600
NEWS_TOPIC_FRESH_S=10800
NEWS_REUSE_SIMILARITY=0.85
NEWS_REUSE_MIN_ITEMS=3
NEWS_SAME_STORY_SIMILARITY=0.85
NEWS_RANK_TOP_N=10
NEWS_RANK_REUSE_TOP_K=10
NEWS_TAGS_ENABLED=true
NEWS_RETENTION_S=172800
NEWS_AIRED_TTL_S=43200
# Background prefetch for active regions: country top stories + NEWS_PREFETCH_TOPICS + the city's geo feed,
# fetched and stored without an LLM call (ranking happens once, on first use)
NEWS_REGION_PREFETCH_ENABLED=true
NEWS_REGION_REFRESH_S=3600
NEWS_PREFETCH_TOPICS=NATION,WORLD
NEWS_GEO_ENABLED=true
# A story's identity is its publisher address. Feeds are saved at once (keyed by Google link, or matched to a
# stored story by the same link or headline); a background worker then decodes each new Google link to the
# publisher address through web_fetch (Google News policy below) and settles the story on it, merging it into a
# stored story with the same address. Decodes are remembered in news_links (failures retried after
# NEWS_LINK_RETRY_S, at most NEWS_LINK_MAX_ATTEMPTS). Linked stories are then read into a summary: the article's
# first NEWS_SUMMARY_SENTENCES sentences (NLTK punkt; photo-credit lines dropped), only when the body has 250+
# characters and 3+ sentences (Market Wizard's gates), else the publisher's description; capped at
# NEWS_SUMMARY_CHARS. No LLM. (Market Wizard's "first 3 + last 2" picked up sign-offs and sidebar text.)
# Then one batched DeepSeek call per NEWS_ANALYSE_BATCH stories (LLM_BACKGROUND) writes each story's card from its
# summary: topic tags, people/organisations, place (resolved on the map), category, tone, radio-worthiness. Stories
# that can't be read are carded from the headline after NEWS_ANALYSE_WAIT_S. Two LLM calls per story in total:
# the headline ranking (fast, on first use) and this card (background). Cards feed the vectors and pulse_detail.
NEWS_LINK_PER_RUN=50
NEWS_LINK_RETRY_S=1800
NEWS_LINK_MAX_ATTEMPTS=3
NEWS_READ_ENABLED=true
NEWS_READ_PARALLEL=3
NEWS_READ_PER_RUN=40
NEWS_SUMMARY_CHARS=900
NEWS_SUMMARY_SENTENCES=5
# How much the hosts are handed is theirs to choose, inside these ceilings. get_news takes a depth (name:stories:
# stories-with-a-summary; the summaries go to the most radio-worthy stories, NEWS_REPORT_SUMMARY_CHARS each).
# pulse_search takes how_many results per kind (PULSE_TOOL_PER_KIND by default, PULSE_TOOL_MAX_PER_KIND at most);
# pulse_detail opens one story's summary.
NEWS_REPORT_DEPTHS=brief:4:1,standard:8:3,detailed:12:6
# Length is the hosts' call (services_radio/talk_clock.py). One depth scale for every segment a DJ tool schedules
# (news, weather, events, places, biography, lyrics, shoutouts): the DJ passes depth from the listener's words and
# SEGMENT_DEPTHS gives its seconds on air, turned into a word ceiling at TALK_WORDS_PER_SECOND (measured 2.0 on
# air on 2026-09-30, reactions and studio sounds included; raise it when the voice engine's paralanguage gets
# shorter). The DJs' own replies have no numbers: a STUDIO CLOCK block tells them what's on air, the time left,
# when vocals come in and what's lined up, and they size the reply to the listener's words. A tool that starts a
# song returns vocals_start_s (from lyric timing with alignment_score >= TALK_ALIGNMENT_MIN); under
# TALK_INTRO_MIN_S the hosts are told to keep it to a line.
SEGMENT_DEPTHS=brief:20,standard:45,detailed:100
TALK_WORDS_PER_SECOND=2.0
TALK_INTRO_MIN_S=4
TALK_ALIGNMENT_MIN=0.5
PULSE_TOOL_PER_KIND=3
PULSE_TOOL_MAX_PER_KIND=8
NEWS_REPORT_SUMMARY_CHARS=320
NEWS_ANALYSE_BATCH=12
NEWS_ANALYSE_PER_RUN=120
NEWS_ANALYSE_WAIT_S=900
# Web gathering (services/web_fetch.py): every scraper and page read goes through one polite layer. Per site:
# requests are spaced (gap + random jitter) and capped in parallel; 5xx and network errors retry with exponential
# back-off and jitter; a 429 or Google "sorry" page rests the site (Retry-After, else WEB_RATE_LIMIT_REST_S,
# doubling on repeats); WEB_REST_AFTER_FAILURES failures in a row rest it WEB_REST_S; pages obey robots.txt
# (cached WEB_ROBOTS_TTL_S). Scraped sites (pages, Google News lookups) each see one consistent browser visitor
# (user agent + language, kept with that site's cookies), rotated every WEB_IDENTITY_REQUESTS requests and after a
# 429 (cookies dropped too). APIs with terms (MusicBrainz) keep PLAiR's own user agent. WEB_USER_AGENTS
# (|-separated) replaces the built-in browser list; keep it to current browser versions.
WEB_PAGE_GAP_S=1.0
WEB_PAGE_JITTER_S=1.0
WEB_PAGE_PARALLEL=2
WEB_GOOGLE_NEWS_GAP_S=2.5
WEB_GOOGLE_NEWS_JITTER_S=2.0
WEB_GOOGLE_NEWS_DAILY_CAP=1500
WEB_REST_AFTER_FAILURES=5
WEB_REST_S=21600
WEB_RATE_LIMIT_REST_S=900
WEB_ROBOTS_TTL_S=86400
WEB_IDENTITY_REQUESTS=150
WEB_USER_AGENTS=
# Weather (OpenWeatherMap) and artist biographies (MusicBrainz -> Wikidata -> Wikipedia) persist across restarts
WEATHER_CACHE_S=1800
WEATHER_PERSIST_ENABLED=true
BIOGRAPHY_PERSIST_ENABLED=true
BIOGRAPHY_TTL_DAYS=30
BIOGRAPHY_NOT_FOUND_TTL_S=86400
# Area signals (Google Geocoding, Air Quality, Pollen on GOOGLE_PLACES_API_KEY): fetched only for active listeners,
# keyed by a coarse grid cell (never the listener's coordinates) and shared by everyone in that cell.
# A 401/403 (API not enabled / key restricted) pauses that API for AREA_BLOCKED_BACKOFF_S.
# Default daily caps keep each API inside Google's monthly free allowance.
AREA_BLOCKED_BACKOFF_S=43200
AREA_RATE_BACKOFF_S=600
AREA_ERROR_RETRY_S=900
AREA_EMPTY_TTL_S=86400
AREA_CACHE_RETENTION_DAYS=7
# Reverse geocoding: "Karangahape Road, Auckland Central, Auckland" for the DJ context and a cue when the
# listener's neighbourhood changes
AREA_GEOCODE_ENABLED=true
AREA_GEOCODE_CELL_M=120
AREA_GEOCODE_TTL_DAYS=30
AREA_GEOCODE_CONTEXT_WAIT_S=1.0
AREA_GEOCODE_DAILY_CAP=330
AREA_GEOCODE_CUES_ENABLED=true
# Air quality: Universal AQI (0-100, higher is cleaner); cue when below the threshold or on a big change
AREA_AIR_QUALITY_ENABLED=true
AREA_AIR_QUALITY_CELL_M=5000
AREA_AIR_QUALITY_REFRESH_S=3600
AREA_AIR_QUALITY_DAILY_CAP=330
AREA_AIR_QUALITY_CUE_BELOW_UAQI=40
AREA_AIR_QUALITY_CUE_DELTA=20
# Pollen: daily forecast per cell (Universal Pollen Index 0-5); cue at or above the index (4 = high)
AREA_POLLEN_ENABLED=true
AREA_POLLEN_CELL_M=8000
AREA_POLLEN_REFRESH_S=86400
AREA_POLLEN_DAILY_CAP=165
AREA_POLLEN_CUE_MIN_INDEX=4

# --- Radio Mode (scheduled talk breaks: hourly news, city update, features) ---
# Listeners opt in from the User panel (default OFF). Breaks only start at a track boundary, never mid-song.
RADIO_MODE_ENABLED=true
# Comma list of segment kinds to switch off station-wide: news, city, local, community, trivia
RADIO_SEGMENTS_DISABLED=
# Start writing + rendering a break this long before the boundary (Orpheus renders slower than real time)
RADIO_PREPARE_LEAD_S=120
# News at :00 and the weather/city update at :30 of the listener's local hour
RADIO_NEWS_MINUTE=0
RADIO_CITY_MINUTE=30
# A clock segment may air from this early before its minute until this late after it, else it is dropped
RADIO_CLOCK_EARLY_S=90
RADIO_CLOCK_LATE_S=900
# Features (local & gigs, community, trivia) rotate every N minutes since the last break
RADIO_FEATURE_INTERVALS_MIN=15,20,30
RADIO_DEFAULT_FEATURE_INTERVAL_MIN=20
RADIO_FEATURE_EARLY_S=60
# A feature is held back if a clock segment is due within this window
RADIO_FEATURE_YIELD_S=600
RADIO_MIN_GAP_S=300
# No break is prepared while the listener is talking to the DJs (seconds after their last turn)
RADIO_CONVERSATION_QUIET_S=60
RADIO_READY_TIMEOUT_S=240
RADIO_MAX_RENDER_ATTEMPTS=2
RADIO_ON_AIR_MAX_S=180
RADIO_WRITE_TIMEOUT_S=60
RADIO_WORDS_PER_SECOND=3.0
RADIO_SEGMENT_MAX_TOKENS=2000
# Station-wide cap on new segment scripts per hour (shared/cached scripts don't count); a cost circuit breaker
RADIO_MAX_SCRIPTS_PER_HOUR=300
# News / city scripts with identical facts are shared by listeners in the same city for this long
RADIO_SHARED_SCRIPT_TTL_S=1500
RADIO_AIRED_MEMORY_S=21600
# The between-track announcer stays quiet at a break boundary and for this long after a break
RADIO_ANNOUNCER_QUIET_AFTER_S=90
RADIO_IDLE_EVICT_S=900
# Instrumental beds under the hosts (MUSIC_BEDS_DIR/manifest.json); bed loudness before ducking
RADIO_BEDS_ENABLED=true
RADIO_BED_TARGET_LUFS=-20
RADIO_BED_MAX_BYTES=26214400

# --- Stings & talking clock (no LLM: station IDs, sweepers, musical stings, robot time checks) ---
# Streamed through the normal DJ audio path (tts_type "sting"), active device only, normal ducking.
STINGS_ENABLED=true
# Between-track stings also play when Radio Mode is off (the listener's "Stings & time checks" toggle still applies)
STINGS_OUTSIDE_RADIO_MODE=true
# Comma list of sting types to switch off: station_id, sweeper, musical, logo_id, time_check
STINGS_TYPES_DISABLED=
# Musical stings (STINGS_DIR/manifest.json, cut from Suno idents; never part of the catalog)
STINGS_DIR=D:/catalog/stings
# Station voice clip cache (exact-key, not the vector cache); how the station name is spelled for Orpheus
# STATION_AUDIO_DIR defaults to data/tts_dj_engine_data/station_audio
STATION_NAME_SPOKEN=Play Air
# Bump to re-render every station clip (e.g. after changing the station voice treatment)
STATION_VOICE_VERSION=1
STATION_VOICE_SEED=7100
STATION_VOICE_TARGET_LUFS=-18
STATION_PROCESS_MIX=0.1
STINGS_TARGET_LUFS=-16
# Riser / sweep bed level under the station voice (dB)
STINGS_BED_UNDER_VOICE_DB=-9
# Announcer windows shorter than this get a sting instead of an LLM line; longer ones get one every Nth break
STINGS_SHORT_WINDOW_S=6
STINGS_MIN_WINDOW_S=1.5
STINGS_ROTATION_N=4
STINGS_MIN_GAP_S=600
STINGS_MAX_GAP_S=900
STINGS_FIRST_DELAY_S=240
# No sting within this many seconds of the listener talking to the DJs
STINGS_CONVERSATION_QUIET_S=30
# Time checks: at most one per MIN interval; on a round minute (multiple of ROUND_MINUTES), any minute after MAX
STINGS_TIME_CHECK_MIN_INTERVAL_S=900
STINGS_TIME_CHECK_MAX_INTERVAL_S=1800
STINGS_TIME_CHECK_ROUND_MINUTES=5
STINGS_TRIGGER_EARLY_MS=300
STINGS_BUILD_LEAD_MS=1500
# Station ID lines not repeated within the last N IDs for a listener
STINGS_ID_NO_REPEAT=8
# Chance that a Radio Mode talk break opens with a station ID / sonic logo
STINGS_BREAK_LEAD_IN_PROBABILITY=0.5
# Radio Mode only: rare short sting in a quiet, lyric-free passage mid-track
STINGS_MIDTRACK_ENABLED=true
STINGS_MIDTRACK_MIN_INTERVAL_S=1200
STINGS_MIDTRACK_PROBABILITY=0.35
STINGS_MIDTRACK_MIN_WINDOW_S=4
STINGS_MIDTRACK_MAX_LEN_S=2.5
STINGS_MIDTRACK_VOICE_MAX_LEN_S=4.5
STINGS_MIDTRACK_CLEAR_S=120
# Station voice parts are pre-rendered at low priority after startup (live DJ speech always wins)
STINGS_PRERENDER_ENABLED=true
STINGS_PRERENDER_DELAY_S=90
STINGS_PRERENDER_SPACING_S=2
STINGS_RENDER_MAX_ATTEMPTS=3
# Clock hours/minutes are checked with the fast Whisper model after rendering; a mismatch is re-rendered
STINGS_VERIFY_NUMBERS=true
# "Plair in {city}" style lines: rendered on first use per city, capped per hour
STINGS_CITY_LINES_ENABLED=true
STINGS_CITY_RENDERS_PER_HOUR=12
# Sound-effects cache clips (by title) usable as sweeper beds, and the top-of-the-hour pips
STINGS_SFX_TITLES=music transition sound effect,DJ transitions sound,transitioning to new track,traffic report whoosh,tuning knobs
STINGS_SFX_PIPS_TITLE=top of the hour beeps

# DJ clip cache evolution: a near match (>= the similarity threshold but below TTS_EXACT_REFRESH_BELOW) plays
# instantly and the exact line renders in the background (low priority, never delays live speech) for next time
TTS_EXACT_REFRESH_ENABLED=true
TTS_EXACT_REFRESH_BELOW=0.97
TTS_EXACT_REFRESH_MAX_PER_HOUR=600

# Server logging (data/logs/radio.log): rotation size/count and categories to switch on/off (comma lists, e.g. api,info)
LOG_FILE_MAX_MB=20
LOG_FILE_BACKUPS=10
LOG_CATEGORIES_ON=
LOG_CATEGORIES_OFF=
